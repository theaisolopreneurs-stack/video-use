*.wav
*.mp3

# Local preview configs (point at local test footage)
.claude/launch.json

# Generated SFX kit (helpers/audio.py --make-sfx)
sfx/

# Downloaded MediaPipe models (helpers/framing.py)
models/

# Looks built from recipes (helpers/looks.py)
luts/generated/

# Session worktrees and local preview config
.claude/worktrees/

# Python installed here, not AppData: the Claude desktop app redirects AppData, so anything
# installed there from inside the app is invisible to a Desktop shortcut.
.python/
